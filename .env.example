# ===================================================
# ProTrack — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ===================================================

# Database Connection (PostgreSQL - Neon / Supabase / Self-hosted)
# Pooled connection string (e.g. pgBouncer) for application queries
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations & DDL operations
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="production"
